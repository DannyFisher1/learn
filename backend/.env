# .env

# --- Ollama Configuration ---
# Base URL for your running Ollama instance
OLLAMA_BASE_URL=http://localhost:11434

# Name of the LLM model pulled in Ollama (e.g., llama3, mistral, gemma)
OLLAMA_LLM_MODEL=llama3

OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

# Name of the Embedding model pulled in Ollama (e.g., nomic-embed-text, mxbai-embed-large)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

OPENAI_API_KEY=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
# --- RAG Configuration ---
# Chunk size for splitting documents
# CHUNK_SIZE=1000 # Example, can be overridden in config.py if needed

# Chunk overlap for splitting documents
# CHUNK_OVERLAP=200 # Example, can be overridden in config.py if needed

# --- Directory Configuration (Optional - can be managed in config.py) ---
UPLOAD_DIR=data/uploads
VECTOR_STORE_DIR=data/vector_store

